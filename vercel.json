{
  "version": 2,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm install && node ./scripts/sync-runtime-config.mjs && npx vite build --config vite.config.fixed.js",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mmc-mms.com"
        }
      ],
      "destination": "https://mmc-mms.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/mms-logo.png", "destination": "/medical_logo.jpg" },
    { "source": "/api/(.*)", "destination": "https://love-api-bomussa.vercel.app/api/$1" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/clinic/(.*)", "destination": "/index.html" },
    { "source": "/qr", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Automation-Level", "value": "98.5-Resilient" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://vercel.com https://*.vercel.com https://*.vercel.app;" }
      ]
    }
  ]
}
