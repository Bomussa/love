{
  "name": "mmc-mms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Medical Committee Integrated Application monorepo (frontend + Supabase backend).",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "tsc",
    "preview": "npm run preview --workspace frontend",
    "lint": "eslint .",
    "test": "npm run test --workspace frontend",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node --test scripts/smoke.test.ts",
    "ci:resilient": "./scripts/resilient-ci.sh",
    "lint:supabase-functions": "deno lint supabase/functions",
    "typecheck:supabase-functions": "deno check supabase/functions/**/*.ts",
    "check:supabase-functions": "npm run lint:supabase-functions && npm run typecheck:supabase-functions",
    "prepare": "./scripts/install-git-hooks.sh",
    "secrets:scan": "./scripts/secret-scan.sh all"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^7.2.1"
  }
}
