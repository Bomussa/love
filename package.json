{
  "name": "mmc-mms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Medical Committee Integrated Application monorepo (frontend + api proxy).",
  "workspaces": [
    "frontend",
    "api"
  ],
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "tsc",
    "preview": "pnpm --filter frontend preview",
    "lint": "eslint .",
    "test": "pnpm --filter frontend test",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node --test scripts/smoke.test.ts",
    "ci:resilient": "./scripts/resilient-ci.sh",
    "release:one-screen": "bash ./scripts/one-screen-release.sh",
    "ci:lockfile": "bash ./scripts/check-single-lockfile.sh"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^7.2.1"
  },
  "packageManager": "pnpm@10.6.0"
}
