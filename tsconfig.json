{
  "compilerOptions": {
    "strict": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "https://deno.land/std*": ["node_modules/@types/node"],
      "https://esm.sh/*": ["node_modules/*"]
    }
  },
  "exclude": [
    "dist",
    "**/*.deno.ts",
    "**/*.deno.js",
    "node_modules",
    "dist",
    "frontend/src/assets",
    "frontend/src/lib/supabase-client.js",
    "frontend/src/assets/js/notifications.js",
    "frontend/src/lib/routingManager.js",
    "scripts/conn-check.mjs",
    "frontend/src/_archived"
  ]
}
