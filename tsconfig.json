{
  "compilerOptions": {
    "strict": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "https://deno.land/std*": [
        "node_modules/@types/node"
      ],
      "https://esm.sh/*": [
        "node_modules/*"
      ]
    }
  },
  "exclude": [
    "archive/**",
    "dist",
    "frontend/dist",
    "frontend/src/**/*.backup",
    "frontend/src/assets/**",
    "frontend/src/lib/supabase-client.js",
    "node_modules",
    "scripts/**/*.ts",
    "scripts/conn-check.mjs"
  ],
  "include": [
    "lib/**/*.js",
    "functions/**/*.js",
    "scripts/**/*.mjs",
    "frontend/src/**/*.js",
    "frontend/src/**/*.jsx",
    "frontend/src/**/*.d.ts"
  ]
}
