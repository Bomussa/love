{
  "compilerOptions": {
    "strict": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "https://deno.land/std*": [
        "node_modules/@types/node"
      ],
      "https://esm.sh/*": [
        "node_modules/*"
      ]
    },
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "frontend/src/lib/supabase-client.js",
    "frontend/src/assets",
    "frontend/public",
    "supabase/functions"
  ]
}
